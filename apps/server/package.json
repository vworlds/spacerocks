{
  "name": "@spacerocks/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json src/index.ts",
    "dev:inspect": "tsx watch --inspect --tsconfig ../../tsconfig.base.json src/index.ts",
    "build": "tsc --noEmit",
    "bundle": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\" && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --tsconfig=tsconfig.json --external:express --external:pino --external:pino-pretty --external:@vworlds/vecs --external:@vworlds/vecs-phaser --external:@vworlds/vecs-phaser-server --external:@vworlds/vecs-physics --external:@vworlds/vecs-server --external:@vworlds/vecs-wire --external:@vworlds/dgram-server --external:node-datachannel --external:box2d3-wasm --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "//": "Leave @vworlds/vecs dependency set to * so this picks up the root package.json's value",
  "dependencies": {
    "@spacerocks/common": "file:../../packages/common",
    "@vworlds/vecs": "1.0.45",
    "@vworlds/vecs-phaser-server": "1.0.45",
    "@vworlds/vecs-physics": "1.0.45",
    "@vworlds/vecs-server": "1.0.45",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4"
  }
}
