{
  "name": "@spacerocks/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json src/index.ts",
    "dev:inspect": "tsx watch --inspect --tsconfig ../../tsconfig.base.json src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "//": "Leave @vworlds/vecs dependency set to * so this picks up the root package.json's value",
  "dependencies": {
    "@spacerocks/common": "file:../../packages/common",
    "@vworlds/vecs": "1.0.31",
    "@vworlds/vecs-phaser-server": "1.0.31",
    "@vworlds/vecs-physics": "1.0.31",
    "@vworlds/vecs-server": "1.0.31",
    "express": "^5.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "tsx": "^4.22.4"
  }
}
